---
import Base from '../layouts/Base.astro';
---

<Base lang="fr" noindex>
  <main id="main" class="flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <img src="/images/logo.png" alt="" width="120" height="120" class="h-28 w-28 rounded-full" />
    <h1 class="script-heading mt-6 text-[4rem]">Page introuvable</h1>
    <p class="mt-2 text-lg italic text-ink-soft" lang="en">Page not found</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="btn btn-primary">Accueil</a>
      <a href="/en/" class="btn btn-outline" lang="en">Home</a>
    </div>
  </main>
</Base>
