---
import '../styles/global.css';
import cormorantUrl from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import alluraUrl from '@fontsource/allura/files/allura-latin-400-normal.woff2?url';
import info from '../data/info.json';
import menu from '../data/menu.json';
import { useTranslations, homePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(info.url);
const canonical = new URL(homePath(lang), site).href;
const altFr = new URL('/', site).href;
const altEn = new URL('/en/', site).href;
const ogImage = new URL('/images/og.jpg', site).href;
const logoUrl = new URL('/images/logo.png', site).href;

// schema.org Restaurant — https://schema.org/Restaurant
const schemaHours = info.hoursConfirmed
  ? info.hours
      .filter((h) => h.open && h.close)
      .map((h) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: `https://schema.org/${h.day.en}`,
        opens: h.open,
        closes: h.close,
      }))
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.href}#restaurant`,
  name: info.name,
  alternateName: info.legalName,
  description: t('meta.description'),
  url: canonical,
  image: [ogImage],
  logo: logoUrl,
  telephone: info.phones.main.tel,
  priceRange: '$$',
  servesCuisine: info.cuisine,
  acceptsReservations: 'True',
  address: {
    '@type': 'PostalAddress',
    streetAddress: info.address.street,
    addressLocality: info.address.city,
    addressRegion: info.address.region,
    ...(info.address.postalCode ? { postalCode: info.address.postalCode } : {}),
    addressCountry: info.address.country,
  },
  sameAs: [info.socials.instagram.url, info.socials.facebook.url].filter((u) => !u.includes('/search/')),
  ...(schemaHours && schemaHours.length ? { openingHoursSpecification: schemaHours } : {}),
  menu: `${canonical}#menu`,
  hasMenu: {
    '@type': 'Menu',
    name: t('menu.title'),
    inLanguage: lang === 'fr' ? 'fr-CA' : 'en-CA',
    url: `${canonical}#menu`,
    hasMenuSection: menu.categories.map((cat) => ({
      '@type': 'MenuSection',
      name: cat.name[lang],
      hasMenuItem: cat.items.map((item: any) => {
        const desc = item.description?.[lang];
        const price = typeof item.price === 'number' ? item.price : item.prices?.[0]?.price;
        return {
          '@type': 'MenuItem',
          name: item.name[lang],
          ...(desc ? { description: desc } : {}),
          ...(typeof price === 'number'
            ? { offers: { '@type': 'Offer', price: price.toFixed(2), priceCurrency: 'CAD' } }
            : {}),
        };
      }),
    })),
  },
};
---

<!doctype html>
<html lang={lang === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang="fr-CA" href={altFr} />
    <link rel="alternate" hreflang="en-CA" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altFr} />
    <meta name="theme-color" content="#2a2a28" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={cormorantUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={alluraUrl} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / social -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content={info.name} />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${info.name} — ${info.tagline[lang]}`} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_CA' : 'fr_CA'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Enables scroll fade-ins only when JS is available -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-charcoal focus:px-4 focus:py-2 focus:text-cream-light"
      >{t('skip')}</a
    >
    <slot />
    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
