---
/** Decorative hand-drawn-style olive branch. Purely ornamental (aria-hidden). */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 220 60"
  fill="none"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d="M6 34 C 60 26, 120 26, 214 30" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  <g fill="currentColor">
    <ellipse cx="38" cy="22" rx="11" ry="3.6" transform="rotate(-28 38 22)" />
    <ellipse cx="46" cy="41" rx="11" ry="3.6" transform="rotate(24 46 41)" />
    <ellipse cx="78" cy="18" rx="12" ry="3.8" transform="rotate(-30 78 18)" />
    <ellipse cx="88" cy="40" rx="12" ry="3.8" transform="rotate(26 88 40)" />
    <ellipse cx="122" cy="17" rx="12" ry="3.8" transform="rotate(-26 122 17)" />
    <ellipse cx="132" cy="39" rx="12" ry="3.8" transform="rotate(24 132 39)" />
    <ellipse cx="166" cy="19" rx="11" ry="3.6" transform="rotate(-22 166 19)" />
    <ellipse cx="176" cy="39" rx="10" ry="3.4" transform="rotate(22 176 39)" />
    <ellipse cx="203" cy="24" rx="9" ry="3.2" transform="rotate(-14 203 24)" />
  </g>
  <circle cx="104" cy="44" r="4.2" fill="currentColor" opacity="0.55" />
  <circle cx="152" cy="45" r="3.8" fill="currentColor" opacity="0.55" />
</svg>
