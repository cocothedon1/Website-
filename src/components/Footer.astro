---
import info from '../data/info.json';
import ScriptName from './ScriptName.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="on-dark bg-charcoal px-4 pt-14 pb-28 text-cream-light sm:px-6 md:pb-14">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 text-center">
    <img src="/images/logo.png" alt="" width="72" height="72" loading="lazy" class="h-[72px] w-[72px] rounded-full" />
    <p class="font-script text-[3rem] leading-none"><ScriptName text={info.name} /></p>
    <p class="text-cream/80 italic">{info.tagline[lang]}</p>

    <address class="not-italic text-[1.05rem] leading-relaxed text-cream/90">
      {info.address.street}, {info.address.city}, {info.address.region}<br />
      <a href={`tel:${info.phones.main.tel}`} class="font-semibold hover:text-lemon">{info.phones.main.display}</a>
      <span aria-hidden="true" class="mx-2 text-lemon">•</span>
      {t('contact.brunchPhone')} :{' '}
      <a href={`tel:${info.phones.brunch.tel}`} class="font-semibold hover:text-lemon">{info.phones.brunch.display}</a>
    </address>

    <div>
      <p class="sr-only">{t('footer.follow')}</p>
      <ul class="flex items-center gap-3">
        <li>
          <a
            href={info.socials.instagram.url}
            target="_blank"
            rel="noopener"
            class="flex h-12 w-12 items-center justify-center rounded-full border border-cream/30 hover:border-lemon hover:text-lemon"
            aria-label={`Instagram — ${info.socials.instagram.label}`}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
          </a>
        </li>
        <li>
          <a
            href={info.socials.facebook.url}
            target="_blank"
            rel="noopener"
            class="flex h-12 w-12 items-center justify-center rounded-full border border-cream/30 hover:border-lemon hover:text-lemon"
            aria-label={`Facebook — ${info.socials.facebook.label}`}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.5V21z"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <p class="text-sm text-cream/70">© {year} {info.legalName}. {t('footer.rights')}</p>
  </div>
</footer>
