---
/**
 * Renders a name in the script font. Allura hides an apostrophe inside the capital's swash
 * (L'aromate reads as "Laromate"), so the apostrophe is nudged right to stay visible.
 */
interface Props {
  text: string;
}
const { text } = Astro.props;
const parts = text.split(/['’]/);
---

{parts.map((p, i) => (i === 0 ? p : <><span class="ml-[0.14em]">’</span>{p}</>))}
