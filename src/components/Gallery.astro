---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import info from '../data/info.json';
import altText from '../data/gallery.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Every image dropped in src/assets/gallery/ is picked up automatically and optimized at build time.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const alts = altText as Record<string, { fr: string; en: string } | string>;
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const file = path.split('/').pop()!;
    const entry = alts[file];
    const alt = typeof entry === 'object' ? entry[lang] : t('gallery.defaultAlt');
    return { src: mod.default, alt };
  });
---

<section id="galerie" aria-labelledby="gallery-title" class="bg-cream-light/60 px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center">
      <h2 id="gallery-title" class="script-heading text-[4rem] sm:text-[5rem]">{t('gallery.title')}</h2>
    </div>

    <ul class="reveal mt-10 grid grid-cols-2 gap-2.5 sm:gap-4 md:grid-cols-4">
      {
        photos.map((p, i) => {
          // On phones (2 columns) the first photo is full width; if that leaves an odd one out, widen the last one too
          const wideLast = i === photos.length - 1 && i > 0 && (photos.length - 1) % 2 === 1;
          return (
          <li class={`overflow-hidden rounded-2xl bg-sand ${i === 0 ? 'col-span-2 row-span-2' : ''} ${wideLast ? 'col-span-2 md:col-span-1' : ''}`}>
            <Image
              src={p.src}
              alt={p.alt}
              widths={i === 0 ? [600, 900, 1200] : [320, 480, 720]}
              sizes={
                i === 0
                  ? '(min-width: 1152px) 570px, (min-width: 768px) 50vw, 100vw'
                  : wideLast
                    ? '(min-width: 1152px) 280px, (min-width: 768px) 25vw, 100vw'
                    : '(min-width: 1152px) 280px, (min-width: 768px) 25vw, 50vw'
              }
              loading="lazy"
              decoding="async"
              class={`h-full w-full object-cover transition-transform duration-700 hover:scale-[1.03] ${wideLast ? 'aspect-[2/1] md:aspect-square' : 'aspect-square'}`}
            />
          </li>
          );
        })
      }
    </ul>

    <p class="mt-10 text-center">
      <a
        href={info.socials.instagram.url}
        class="btn btn-outline"
        rel="noopener"
        target="_blank"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
        {t('gallery.follow')}<span class="hidden sm:inline"> · {info.socials.instagram.label}</span>
      </a>
    </p>
  </div>
</section>
