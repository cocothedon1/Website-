---
import info from '../data/info.json';
import ScriptName from './ScriptName.astro';
import { useTranslations, homePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';

const links = [
  { href: '#brunch', label: t('nav.brunch') },
  { href: '#menu', label: t('nav.menu') },
  { href: '#a-propos', label: t('nav.about') },
  { href: '#galerie', label: t('nav.gallery') },
  { href: '#nous-trouver', label: t('nav.contact') },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-cream/90 backdrop-blur-md transition-[border-color,box-shadow] duration-300 data-[scrolled]:border-sand data-[scrolled]:shadow-[0_6px_20px_-14px_rgba(42,42,40,0.5)]"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={homePath(lang)} class="flex items-center gap-2.5" aria-label={`${info.name} — ${t('nav.label')}`}>
      <img src="/images/logo.png" alt="" width="40" height="40" class="h-10 w-10 rounded-full" />
      <span class="font-script text-[2rem] leading-none text-charcoal"><ScriptName text={info.name} /></span>
    </a>

    <nav aria-label={t('nav.label')} class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[1.05rem] font-semibold">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="underline-offset-8 decoration-olive decoration-2 hover:underline">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={homePath(other)}
        hreflang={other}
        lang={other}
        aria-label={t('lang.switchLabel')}
        class="rounded-full border border-charcoal/30 px-3 py-1.5 text-sm font-bold tracking-widest uppercase hover:bg-charcoal hover:text-cream-light"
        >{other.toUpperCase()}</a
      >
      <a href={`tel:${info.phones.main.tel}`} class="btn btn-primary hidden !min-h-0 !py-2 !text-base sm:inline-flex">
        {t('cta.reserve')}
      </a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.open')}
        data-label-open={t('nav.open')}
        data-label-close={t('nav.close')}
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path class="nav-icon-open" d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <path class="nav-icon-close hidden" d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={t('nav.label')} class="hidden border-t border-sand bg-cream lg:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2 text-xl font-semibold">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block border-b border-sand/70 py-3.5 last:border-0">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('mobile-nav')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    panel.classList.toggle('hidden', !open);
    toggle.querySelector('.nav-icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.nav-icon-close')!.classList.toggle('hidden', !open);
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
