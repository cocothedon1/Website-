---
import info from '../data/info.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const q = encodeURIComponent(info.address.mapsQuery);
const mapSrc = `https://www.google.com/maps?q=${q}&output=embed&hl=${lang}`;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${q}`;
const fullAddress = [info.address.street, `${info.address.city}, ${info.address.region}`, info.address.postalCode]
  .filter(Boolean)
  .join(', ');
---

<section id="nous-trouver" aria-labelledby="contact-title" class="px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="reveal text-center">
      <h2 id="contact-title" class="script-heading text-[4rem] sm:text-[5rem]">{t('contact.title')}</h2>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_1.35fr] lg:gap-12">
      <div class="reveal space-y-8">
        <div>
          <h3 class="kicker">{t('contact.address')}</h3>
          <address class="mt-2 text-[1.3rem] not-italic font-semibold text-charcoal">
            {info.address.street}<br />
            {info.address.city}, {info.address.region}{info.address.postalCode && <> {info.address.postalCode}</>}
          </address>
          <a href={directions} target="_blank" rel="noopener" class="mt-2 inline-block font-semibold text-olive-dark underline decoration-olive/40 underline-offset-4 hover:decoration-olive">
            {t('contact.directions')} →
          </a>
        </div>

        <div>
          <h3 class="kicker">{t('contact.phone')}</h3>
          <a href={`tel:${info.phones.main.tel}`} class="mt-1 block text-[1.5rem] font-bold text-charcoal hover:text-olive-dark">
            {info.phones.main.display}
          </a>
          <p class="mt-3 text-base text-ink-soft">
            {t('contact.brunchPhone')} :{' '}
            <a href={`tel:${info.phones.brunch.tel}`} class="font-bold text-charcoal hover:text-olive-dark">{info.phones.brunch.display}</a>
          </p>
        </div>

        <div>
          <h3 class="kicker">{t('contact.hours')}</h3>
          {
            info.hoursConfirmed ? (
              <dl class="mt-3 divide-y divide-sand text-[1.1rem]">
                {info.hours.map((h) => (
                  <div class="flex justify-between gap-4 py-1.5">
                    <dt class="font-semibold">{h.day[lang]}</dt>
                    <dd class="text-ink-soft">{h.open && h.close ? `${h.open} – ${h.close}` : t('contact.closed')}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="mt-2 rounded-xl border border-dashed border-olive/50 bg-cream-light/70 px-4 py-3 text-[1.1rem] text-ink italic">
                {t('contact.hoursTbd')}
              </p>
            )
          }
        </div>
      </div>

      <div class="reveal overflow-hidden rounded-3xl border border-sand bg-sand shadow-[0_24px_50px_-30px_rgba(42,42,40,0.6)]">
        <iframe
          title={t('contact.mapTitle')}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-[320px] w-full border-0 sm:h-[420px] lg:h-full lg:min-h-[460px]"
          allowfullscreen
        ></iframe>
        <noscript><p class="p-4">{fullAddress}</p></noscript>
      </div>
    </div>
  </div>
</section>
