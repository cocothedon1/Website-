---
/** Thumb-friendly call/menu bar pinned to the bottom of the screen on phones. */
import info from '../data/info.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="on-dark fixed inset-x-0 bottom-0 z-50 border-t border-cream/10 bg-charcoal/95 px-3 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] backdrop-blur-md md:hidden"
>
  <div class="mx-auto flex max-w-md gap-2.5">
    <a href={`tel:${info.phones.main.tel}`} class="btn btn-lemon flex-1 !px-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      {t('cta.reserveShort')}
    </a>
    <a href="#menu" class="btn flex-1 border border-cream/30 !px-3 text-cream-light">{t('nav.menu')}</a>
  </div>
</div>
