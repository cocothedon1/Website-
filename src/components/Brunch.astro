---
import info from '../data/info.json';
import OliveBranch from './OliveBranch.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const brunchHours = info.brunch.hours[lang];
const brunchPrice = info.brunch.price[lang];
---

<section id="brunch" aria-labelledby="brunch-title" class="px-4 py-14 sm:px-6 sm:py-20">
  <div
    class="on-dark reveal relative mx-auto max-w-5xl overflow-hidden rounded-[2rem] bg-charcoal px-6 py-12 text-cream-light shadow-[0_30px_60px_-30px_rgba(42,42,40,0.7)] sm:px-12 sm:py-16"
  >
    <OliveBranch class="pointer-events-none absolute -right-10 -top-2 w-72 rotate-[160deg] text-olive-light/25 sm:w-[26rem]" />
    <div class="relative grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <p class="text-[0.8125rem] font-bold tracking-[0.22em] text-lemon uppercase">{t('brunch.kicker')}</p>
        <h2 id="brunch-title" class="mt-3 font-script text-[3.75rem] leading-none text-cream-light sm:text-[5rem]">
          {t('brunch.title')}
        </h2>
        <p class="mt-4 text-xl text-cream/90 italic">
          {info.brunch.days[lang]}{brunchHours && <> · {brunchHours}</>}{brunchPrice && <> · {brunchPrice}</>}
        </p>
        <ul class="mt-7 space-y-3 text-[1.2rem]">
          {
            t('brunch.points').map((p) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1.5 shrink-0 text-lemon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <ellipse cx="8" cy="8" rx="7" ry="3.2" transform="rotate(-35 8 8)" fill="currentColor" />
                </svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-3xl border border-cream/15 bg-white/[0.04] p-7 text-center md:mx-auto md:w-full md:max-w-md lg:max-w-none">
        <p class="text-[0.8125rem] font-bold tracking-[0.22em] text-lemon uppercase">{t('brunch.reserve')}</p>
        <a
          href={`tel:${info.phones.brunch.tel}`}
          class="mt-3 block font-serif text-[2.1rem] font-semibold tracking-wide text-cream-light hover:text-lemon-soft"
          >{info.phones.brunch.display}</a
        >
        <a href={`tel:${info.phones.brunch.tel}`} class="btn btn-lemon mt-6 w-full">
          {t('brunch.cta')}
        </a>
      </div>
    </div>
  </div>
</section>
