---
import info from '../data/info.json';
import ScriptName from './ScriptName.astro';
import OliveBranch from './OliveBranch.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden bg-[radial-gradient(ellipse_at_top,var(--color-cream-light)_0%,var(--color-cream)_62%)]"
>
  <OliveBranch class="pointer-events-none absolute -left-10 top-10 -z-10 w-56 -rotate-12 text-olive/15 sm:w-80" />
  <OliveBranch class="pointer-events-none absolute -right-12 bottom-8 -z-10 w-60 rotate-[168deg] text-olive/15 sm:w-96" />

  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 pt-12 pb-16 text-center sm:px-6 sm:pt-16 sm:pb-24">
    <img
      src="/images/logo.png"
      alt={t('hero.logoAlt')}
      width="176"
      height="176"
      fetchpriority="high"
      class="h-36 w-36 rounded-full shadow-[0_18px_40px_-18px_rgba(42,42,40,0.55)] sm:h-44 sm:w-44"
    />

    <h1 id="hero-title" class="script-heading mt-6 text-[4.5rem] sm:text-[6.5rem]"><ScriptName text={info.name} /></h1>

    <p class="mt-2 text-xl font-semibold text-ink-soft italic sm:text-2xl">{info.tagline[lang]}</p>

    <p class="kicker mt-6 flex flex-wrap items-center justify-center gap-x-3 !text-[0.9rem] !text-olive-dark">
      {
        info.services[lang].map((s, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-lemon">•</span>}
            <span>{s}</span>
          </>
        ))
      }
    </p>

    <div class="mt-9 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
      <a href={`tel:${info.phones.main.tel}`} class="btn btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        {t('cta.reserve')}
      </a>
      <a href="#menu" class="btn btn-outline">{t('cta.menu')}</a>
    </div>

    <p class="mt-5 text-base text-ink-soft">
      <a href={`tel:${info.phones.main.tel}`} class="font-semibold underline decoration-olive/50 underline-offset-4 hover:decoration-olive">{info.phones.main.display}</a>
      <span aria-hidden="true" class="mx-2">·</span>
      {info.address.street}, {info.address.city}
    </p>
  </div>
</section>
