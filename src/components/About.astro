---
import info from '../data/info.json';
import OliveBranch from './OliveBranch.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Editable text: see "about" in src/data/info.json
const paragraphs = info.about[lang];
---

<section id="a-propos" aria-labelledby="about-title" class="px-4 py-16 sm:px-6 sm:py-24">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="kicker">{t('about.kicker')}</p>
    <h2 id="about-title" class="script-heading mt-2 text-[4rem] sm:text-[5rem]">{t('about.title')}</h2>
    <div class="mt-6 space-y-5 text-[1.25rem] leading-relaxed text-ink">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <OliveBranch class="mx-auto mt-10 w-40 text-olive/70" />
  </div>
</section>
